#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/chiseche-agro/node_modules/.pnpm/@vercel+sdk@1.21.8/node_modules/@vercel/sdk/node_modules:/chiseche-agro/node_modules/.pnpm/@vercel+sdk@1.21.8/node_modules:/chiseche-agro/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/chiseche-agro/node_modules/.pnpm/@vercel+sdk@1.21.8/node_modules/@vercel/sdk/node_modules:/chiseche-agro/node_modules/.pnpm/@vercel+sdk@1.21.8/node_modules:/chiseche-agro/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../bin/mcp-server.js" "$@"
else
  exec node  "$basedir/../../bin/mcp-server.js" "$@"
fi
